# Copy to .env before `docker compose up`. No defaults for secrets on purpose — compose fails
# loudly on a missing one rather than starting with a guessable password.
# Use URL-safe values (e.g. `openssl rand -hex 24`): the database passwords are embedded in
# connection URLs.
POSTGRES_PASSWORD=
# Password for the restricted `aperture_api` role the API and worker connect as.
APERTURE_DB_API_PASSWORD=
MINIO_ROOT_USER=aperture
MINIO_ROOT_PASSWORD=

# Where uploaders reach MinIO's S3 API. Presigned upload URLs are signed for this address, so
# set it to the host name (and TLS proxy) your robots and browsers actually use.
APERTURE_PUBLIC_STORAGE_URL=http://localhost:9000

# Bootstraps the first API key. Mint real per-org keys through /v1/onboarding once up, then
# remove this one — it is stored in plaintext in the environment, unlike issued keys.
APERTURE_BOOTSTRAP_KEY=
# The org that key belongs to; created on first start if missing.
APERTURE_BOOTSTRAP_ORG=acme-robotics
APERTURE_BOOTSTRAP_ORG_NAME=Acme Robotics

# Optional. When set, POST /v1/onboarding/signup is open to callers sending it as X-Signup-Token.
# When empty, signup is closed; provision orgs with `docker compose exec api python -m
# aperture.admin create-org --slug <slug> --name <name>`.
APERTURE_SIGNUP_TOKEN=

# Gates the dashboard (and the API proxy behind it). Required in production.
APERTURE_DASHBOARD_PASSWORD=
# Signs session cookies. Defaults to the password above; set it separately so that rotating the
# password and invalidating everyone's live session stay independent decisions.
APERTURE_SESSION_SECRET=
