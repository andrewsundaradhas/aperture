# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.aperture_data/
.env

# Node / Next.js
node_modules/
.next/
out/
.vercel/
npm-debug.log*

# Local env overrides. apps/web/.env.example tells you to copy it to .env.local, which the
# bare `.env` rule above does not match — without these the copy gets committed with its key.
.env.local
.env.*.local

# ML weights (never commit checkpoints; configs and metrics only)
ml/models/*.bin
ml/models/*.safetensors
ml/models/*.pt
ml/models/checkpoints/

# Training data downloaded from the Hub, and the decoded-frame cache beside it
ml/data/

# Training run logs (metrics.json is the artifact worth committing, not the console log)
ml/train.log

# OS
.DS_Store
Thumbs.db
