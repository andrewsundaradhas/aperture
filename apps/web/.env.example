# Copy to .env.local. Defaults target the local backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=demo-key

# Sentry (optional, free tier). Leave blank locally — error capture stays off until set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Set in Vercel CI for source-map upload (not needed to run):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
