# Copy to .env for local overrides. All are optional — defaults give a zero-cost local stack.
# APERTURE_DATABASE_URL=postgresql+psycopg2://postgres:pass@db.supabase.co:5432/postgres
# APERTURE_R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# APERTURE_R2_ACCESS_KEY_ID=...
# APERTURE_R2_SECRET_ACCESS_KEY=...
# APERTURE_R2_BUCKET=aperture-blobs
# APERTURE_API_KEYS=<locally-generated-key>:acme-robotics
# Enables POST /v1/onboarding/signup for callers sending it as X-Signup-Token. Unset in production
# = signup closed (use `python -m aperture.admin create-org`). Unset locally = open.
# APERTURE_SIGNUP_TOKEN=
# Only where clients reach storage at a different address than the API does (docker-compose).
# APERTURE_R2_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Classify failed episodes automatically after upload/ingest (default true).
# APERTURE_AUTO_CLASSIFY=true
# Zip-bomb / memory guards for dataset uploads.
# APERTURE_MAX_EXTRACTED_BYTES=21474836480
# APERTURE_MAX_ARCHIVE_MEMBERS=200000
# APERTURE_MAX_INGEST_BYTES=5368709120
# APERTURE_SENTRY_DSN=

# --- Learned models (optional; requires `pip install -e ".[ml]"`) ---
# Off by default: the API runs the heuristic/simulated path with zero ML dependencies.
# APERTURE_USE_LEARNED_MODELS=true
# APERTURE_MODEL_DEVICE=cpu          # "cuda", or "mps" on Apple silicon
# Defaults to the checkout's ml/models — exactly where ml/training/train.py writes the weights.
# APERTURE_LOCAL_MODEL_DIR=/path/to/dir
# Fallback when a checkpoint is missing locally. Unset by default (no download ever happens
# unless you configure it); point it at a repo you own. Weights load with weights_only=True.
# APERTURE_HF_MODEL_REPO=your-org/your-aperture-policy
