# Copy to .env for local overrides. All are optional — defaults give a zero-cost local stack.
# APERTURE_DATABASE_URL=postgresql+psycopg2://postgres:pass@db.supabase.co:5432/postgres
# APERTURE_R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# APERTURE_R2_ACCESS_KEY_ID=...
# APERTURE_R2_SECRET_ACCESS_KEY=...
# APERTURE_R2_BUCKET=aperture-blobs
# APERTURE_API_KEYS=demo-key:acme-robotics
# APERTURE_SENTRY_DSN=

# --- Learned models (optional; requires `pip install -e ".[ml]"`) ---
# Off by default: the API runs the heuristic/simulated path with zero ML dependencies.
# APERTURE_USE_LEARNED_MODELS=true
# APERTURE_MODEL_DEVICE=cpu          # "cuda", or "mps" on Apple silicon
# Defaults to the checkout's ml/models — exactly where ml/training/train.py writes the weights.
# APERTURE_LOCAL_MODEL_DIR=/path/to/dir
# Fallback when a checkpoint is missing locally. No public reference repo exists; point this
# at one you own after publishing your own training run.
# APERTURE_HF_MODEL_REPO=your-org/your-aperture-policy
